# ==============================================================================
# GreenChain / Maize Advisor Environment Variables (Template)
# Copy this file to .env and fill in your values.
# ==============================================================================

# Supabase Configuration (Frontend - Public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq LLM API Key (Local Vite Dev Fallback)
# In production on Vercel: set GROQ_API_KEY in the Vercel Dashboard Environment Variables!
VITE_GROQ_API_KEY=your-groq-api-key
