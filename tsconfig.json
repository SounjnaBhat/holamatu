{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "packages/**/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/**/test/**",
    "packages/**/android/**"
  ]
}
